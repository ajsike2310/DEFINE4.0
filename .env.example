# Copy to .env and fill in. NEVER commit .env.
CALL_PROVIDER=demo                 # demo | exotel
PUBLIC_BASE_URL=                   # e.g. https://<id>.ngrok-free.app
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=                  # your ExoPhone
EXOTEL_FLOW_URL=                   # http://my.exotel.com/<sid>/exoml/start_voice/<flow_id>
EXOTEL_STREAM_URL=                 # wss://<host>/live/exotel/<EXOTEL_WEBHOOK_TOKEN>  (flow-free live call)
EXOTEL_CLARIFY_FLOW_URL=
EXOTEL_BASE_URL=https://api.exotel.com
EXOTEL_WEBHOOK_TOKEN=
EXOTEL_ALLOWED_NUMBERS=            # comma-separated test numbers; keep set while testing
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2   # ElevenLabs Multilingual v2
ELEVENLABS_STT_MODEL=scribe_v2                # ElevenLabs Scribe v2

# --- live conversation (member3/live) ---
BACKEND_RESULT_URL=                # backend endpoint that receives each call result (POST JSON)
BACKEND_RESULT_TOKEN=              # sent as "Authorization: Bearer <token>"
LIVE_BARGE_IN=0                    # 1 = caller may interrupt the agent (needs a clean line)
LIVE_NO_SPEECH_TIMEOUT_MS=7000
LIVE_LOG_TRANSCRIPT=0              # DEV ONLY: 1 logs what the caller said (personal data)
# Dev demo campaign (scripts.run_live only)
DEV_EVENT_NAME=TechFest
DEV_VENUE=the main auditorium
DEV_EVENT_DATE=November 15th
DEV_EVENT_TIME=10 AM
DEV_ORGANISER=your college
DEV_LANGUAGE=en                   # greeting language for the demo campaign: en | hi | ta

# --- campaign dashboard (python -m scripts.run_dashboard) ---
STREAM_PORT=8003                   # live-audio WebSocket (real calls). Tunnel THIS port to the internet, never the dashboard port
DASHBOARD_DB=data/dashboard.db     # SQLite file holding events, contact lists and per-call outcomes (no audio/transcripts)
DASHBOARD_TOKEN=                   # set this before exposing the dashboard: every /api call then needs it
CALL_WINDOW=09:00-21:00            # real calls are refused outside these local (IST) hours; empty = no limit
DIAL_INTERVAL_S=1.5                # pause between dials
MAX_ATTEMPTS=3
DASHBOARD_ENFORCE_ALLOWLIST=0     # 1 = only dial EXOTEL_ALLOWED_NUMBERS (safe testing); 0 = dial any number added to an event
