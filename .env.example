# Copy to .env (git-ignored). Placeholders only — never commit real values.
DATABASE_URL=sqlite:///data/app.db
CALL_PROVIDER=demo            # demo | exotel
MAX_CALL_ATTEMPTS=3
RETRY_BACKOFF_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# ElevenLabs: voice + speech-to-text for the browser demo call (key stays in .env, never in chat or logs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # any voice available to your account
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# Exotel (only needed when CALL_PROVIDER=exotel)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_BASE_URL=https://api.exotel.com
EXOTEL_CALLER_ID=             # your ExoPhone
EXOTEL_FLOW_URL=              # http://my.exotel.com/<sid>/exoml/start_voice/<app_id>
EXOTEL_CLARIFY_FLOW_URL=      # optional second flow: one yes(1)/no(2) question for clarify-once calls
EXOTEL_WEBHOOK_TOKEN=         # long random string; appended to the StatusCallback URL
EXOTEL_ALLOWED_NUMBERS=       # comma-separated approved test numbers (strongly recommended)
PUBLIC_BASE_URL=              # public https URL of this backend, for StatusCallback
DATA_LOCATION_NOTE=Local SQLite file on the machine running the backend.
